# ===== Обязательные =====

# Токен бота от @BotFather в Telegram
BOT_TOKEN=123456:ABC-DEF...

# Твой Telegram user ID (узнать: напиши @userinfobot).
# Этот пользователь становится владельцем с полными правами.
OWNER_ID=123456789

# ===== ИИ-помощник (Claude) =====

# Ключ Anthropic API. Получить: https://console.anthropic.com/ -> Settings -> API Keys
# Без ключа бот работает, но команды ИИ будут недоступны.
ANTHROPIC_API_KEY=sk-ant-...

# Модель. По умолчанию — самая мощная (Opus 4.8). Можно сменить на claude-sonnet-5 (дешевле/быстрее).
ANTHROPIC_MODEL=claude-opus-4-8

# ===== Необязательные =====

# Часовой пояс для напоминаний и дайджеста (по умолчанию Europe/Moscow)
TZ=Europe/Moscow

# Час утреннего дайджеста, 0-23 (по умолчанию 9 — в 9:00 утра)
DIGEST_HOUR=9

# Путь к файлу базы данных (по умолчанию data/assistant.db).
# На PaaS с постоянным диском укажи путь в примонтированную папку, например /data/assistant.db
DB_PATH=data/assistant.db

# === Mini App (веб-интерфейс задач внутри Telegram) ===
# Публичный HTTPS-адрес приложения — его выдаёт хостинг после деплоя.
# Пример: WEBAPP_URL=https://assistant-xxxx.amvera.io
# Пока пусто — бот работает как обычно, кнопка приложения появится после деплоя.
WEBAPP_URL=

# Порт веб-сервера. На большинстве PaaS не трогай — платформа передаёт свой через PORT.
WEB_PORT=8080

# === Обход блокировки Telegram (если хостинг режет api.telegram.org) ===
# Выбери ОДИН способ. Если Telegram доступен напрямую — оставь оба пустыми.

# Способ 1 (рекомендуется): свой адрес Telegram Bot API — например, прокси на
# Cloudflare Workers. Укажи базовый адрес воркера без слэша на конце.
# Пример: TELEGRAM_API_URL=https://tg-proxy.ТВОЙ-логин.workers.dev
TELEGRAM_API_URL=

# Способ 2: SOCKS5/HTTP прокси (нужен зарубежный).
#   SOCKS5:  socks5://user:pass@host:port
#   HTTP:    http://user:pass@host:port
PROXY_URL=
