# ===== Обязательные =====

# Токен бота от @BotFather в Telegram
BOT_TOKEN=123456:ABC-DEF...

# Твой Telegram user ID (узнать: напиши @userinfobot).
# Этот пользователь становится владельцем с полными правами.
OWNER_ID=123456789

# ===== ИИ-помощник (Claude) =====

# Ключ Anthropic API. Получить: https://console.anthropic.com/ -> Settings -> API Keys
# Без ключа бот работает, но команды ИИ будут недоступны.
ANTHROPIC_API_KEY=sk-ant-...

# Модель. По умолчанию — самая мощная (Opus 4.8). Можно сменить на claude-sonnet-5 (дешевле/быстрее).
ANTHROPIC_MODEL=claude-opus-4-8

# ===== Необязательные =====

# Часовой пояс для напоминаний и дайджеста (по умолчанию Europe/Moscow)
TZ=Europe/Moscow

# Час утреннего дайджеста, 0-23 (по умолчанию 9 — в 9:00 утра)
DIGEST_HOUR=9

# Путь к файлу базы данных (по умолчанию data/assistant.db)
DB_PATH=data/assistant.db
